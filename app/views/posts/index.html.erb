<div class="flex flex-col justify-center items-center p-5">
  <%= form_with model: @post, class: "p-5 bg-white rounded-2xl w-full max-w-[50em]" do |form| %>
    <%= form.text_area :body, 
      required: true,
      placeholder: "What are your thoughts?",
      class: "form-input w-full h-[10em] resize-none" 
    %>
    <div class="flex w-full justify-end">
      <%= form.submit "post", class: "form-submit" %>
    </div>
  <% end %>
</div>
