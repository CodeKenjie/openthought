<div class="flex justify-center items-center w-full h-full">
  <div data-controller="registration" class="form-container">
    <%= form_with url: sessions_path, class: "form" do |form| %>
      <h1 class="text-3xl font-bold">Login</h1>
      <div class="form-div">
        <%= form.label :login,
          "Email",
          class: "form-label"
        %>
        <%= form.email_field :login,
          required: true,
          class: "form-input"
        %>
      </div>
      <div class="form-div">
        <%= form.label :password,
          "Password",
          class: "form-label"
        %>
        <div class="relative flex items-center gap-2 overflow-x-hidden">
          <%= form.password_field :password, 
            required: true,
            class: "form-input",
            style: "padding-right: 5.5rem",
            data: { registration_target: "password" }
          %>
          <button type="button" 
            class="absolute right-4 w-[3rem] h-[3rem] cursor-pointer opacity-50 hover:opacity-100" 
            data-action="click->registration#togglePassword"
            data-target-field="password" 
            data-icon-target="passIcon" 
            data-show-icon="<%= asset_path('show.svg') %>" 
            data-hide-icon="<%= asset_path('hide.svg') %>"
          >
            <%= image_tag "show.svg",
              class: "w-full h-full",
              data: { registration_target: "passIcon" }
            %>
          </button>
        </div>
      </div>
      <div class="flex gap-2 w-full justify-end">
        <%= link_to "Create an Account", new_user_path, class: "btn opacity-80 hover:opacity-100" %>
        <%= form.submit "Login", 
          class: "form-submit"
        %>
      </div>
    <% end %>
  </div>
</div>
