<%= form_with model: user, class: "form" do |form| %>
  <div data-registration-target="step" class="flex flex-col gap-2">
    <div class="form-div">
      <%= form.label :first_name, 
        "First Name",
        class: "form-label"
      %>
      <%= form.text_field :first_name, 
        required: true,
        class: "form-input",
        data: { registration_target: "firstName" }
      %>
    </div>
    <div class="form-div">
      <%= form.label :last_name, 
        "Last Name",
        class: "form-label"
      %>
      <%= form.text_field :last_name, 
        required: true,
        class: "form-input",
        data: { registration_target: "lastName" }
      %>
    </div>
    <div class="flex w-full justify-end">
      <button class="btn" type="button" data-action="registration#next">Next</button>
    </div>
  </div>

  <div data-registration-target="step" class="hidden flex flex-col gap-2">
    <div class="form-div">
      <%= form.label :username, 
        "Username",
        class: "form-label"
      %>
      <div class="relative flex items-center overflow-x-hidden">
        <%= form.text_field :username, 
          required: true,
          class: "form-input",
          style: "padding-right: 5.5rem",
          data: { 
            registration_target: "username",
            action: "input->registration#checkUsername"
          }
        %>
        <p data-registration-target="usernameCheckingLabel" class="absolute right-3 text-xs font-bold"></p>
      </div>
    </div>
    <div class="form-div">
      <%= form.label :email, 
        "Email",
        class: "form-label"
      %>
      <div class="relative flex items-center overflow-x-hidden">
        <%= form.email_field :email, 
          required: true,
          autocomplete: true,
          class: "form-input",
          style: "padding-right: 5.5rem",
          data: { 
            registration_target: "email",
            action: "input->registration#checkEmail"
          }
        %>
      <p data-registration-target="emailCheckingLabel" class="absolute right-3 text-xs font-bold"></p>
      </div>
    </div>
    <div class="flex gap-2 w-full justify-end">
      <button class="btn" type="button" data-action="registration#previous">Previous</button>
      <button class="btn" type="button" data-action="registration#next">Next</button>
    </div>
  </div>

  <div data-registration-target="step" class="hidden flex flex-col gap-2">
    <div class="form-div">
      <%= form.label :password, 
        "Password",
        class: "form-label"
      %>
      <%= form.password_field :password, 
        required: true,
        class: "form-input",
        data: { registration_target: "password" }
      %>
    </div>
    <div class="form-div">
      <%= form.label :password_confirmation, 
        "Confirm Password",
        class: "form-label"
      %>
      <%= form.password_field :password_confirmation, 
        required: true,
        class: "form-input",
        data: { registration_target: "confirmPassword" }
      %>
    </div>
    <div class="flex gap-2">
      <%= form.check_box :terms_accepted %>
      <%= form.label :terms_accepted,
        "I accept the terms and conditions",
        class: "form-label" %>
    </div>
    <div class="flex gap-2 w-full justify-end">
      <button class="btn" type="button" data-action="registration#previous">Previous</button>
      <%= form.submit "Submit", class: "form-submit"%>
    </div>
  </div>
<% end %>
