<div class="flex flex-wrap justify-center p-5 gap-3 w-screen h-fit" data-controller="users">
  <% if current_user == @user %>
    <%= form_with model: @user, data: { users_target: "editForm" }, class: "hidden flex flex-col gap-3 bg-white rounded-4xl p-5 shadow w-full max-w-[50em] h-fit" do |form| %>
      <div class="form-div">
        <%= form.label :username, "Username", class: "form-label" %>
        <%= form.text_field :username, required: true, class: "form-input" %>
      </div>
      <div class="form-div">
        <%= form.label :first_name, "First Name", class: "form-label" %>
        <%= form.text_field :first_name, required: true, class: "form-input" %>
      </div>
      <div class="form-div">
        <%= form.label :last_name, "Last Name", required: true, class: "form-label" %>
        <%= form.text_field :last_name, class: "form-input" %>
      </div>
      <div class="form-div">
        <%= form.label :date_of_birth, "Birthday", class: "form-label" %>
        <%= form.date_field :date_of_birth, class: "form-input" %>
      </div>
      <div class="flex flex-wrap justify-end gap-2">
        <button class="btn opacity-80 hover:opacity-100" type="button" data-action="click->users#editToggle">cancel</button>
        <%= form.submit "edit", class: "form-submit" %>
      </div>
    <% end %>
  <%end%>
  <div class="flex flex-col gap-3 bg-white rounded-4xl p-5 shadow w-full max-w-[50em] h-fit" data-users-target="profile">
    <% if current_user == @user %>
      <div class="flex w-full justify-end">
        <button class="w-[1.5em] h-[1.5em] opacity-50 hover:opacity-100 cursor-pointer" data-action="click->users#editToggle">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M21.2799 6.40005L11.7399 15.94C10.7899 16.89 7.96987 17.33 7.33987 16.7C6.70987 16.07 7.13987 13.25 8.08987 12.3L17.6399 2.75002C17.8754 2.49308 18.1605 2.28654 18.4781 2.14284C18.7956 1.99914 19.139 1.92124 19.4875 1.9139C19.8359 1.90657 20.1823 1.96991 20.5056 2.10012C20.8289 2.23033 21.1225 2.42473 21.3686 2.67153C21.6147 2.91833 21.8083 3.21243 21.9376 3.53609C22.0669 3.85976 22.1294 4.20626 22.1211 4.55471C22.1128 4.90316 22.0339 5.24635 21.8894 5.5635C21.7448 5.88065 21.5375 6.16524 21.2799 6.40005V6.40005Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M11 4H6C4.93913 4 3.92178 4.42142 3.17163 5.17157C2.42149 5.92172 2 6.93913 2 8V18C2 19.0609 2.42149 20.0783 3.17163 20.8284C3.92178 21.5786 4.93913 22 6 22H17C19.21 22 20 20.2 20 18V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
        </button>
      </div>
    <%end%>
    <span class="overflow-x-hidden">
      <h1 class="text-4xl font-bold"><%= @user.username %></h1>
      <h3 class="text-xl opacity-50"><%= @user.email %></h3>
    </span>
    <div>
      <span>
        <h3 class="text-2xl overflow-x-hidden">Name: <%= "#{@user.first_name} #{@user.last_name}" %></h1>
        <h3 class="text-2xl overflow-x-hidden">Birthday: <%= @user.date_of_birth %></h3>
        <h3 class="text-2xl overflow-x-hidden <%= @user.verified ? "text-green-800" : "text-red-800" %>" >Verified?: <%= @user.verified ? "verified" : "Not verified" %></h3>
      </span>
    </div>
  </div>
  <ul class="flex flex-col gap-3 w-full max-w-[50em] h-full max-h-[80em] overflow-y-auto">
    <% @user.posts.each do |post|%>
      <li class="card overflow-hidden">
        <div class="flex flex-wrap justify-between w-full items-center gap-2">
          <%= link_to user_path(post.user.id), class: "flex flex-wrap gap-2 overflow-x-hidden" do %>
            <h3 class="text-xl font-bold"><%= post.user.username %></h3>
            <h4 class="text-xl opacity-50"><%= post.user.email %></h4>
          <% end %>
          <p class="opacity-50 overflow-x-hidden"><%= post.created_at.strftime("%m-%d-%Y %I:%M%p ") %></p>
        </div>

        <div class="flex flex-col gap-5 overflow-x-hidden w-full hover:bg-gray-100 p-2 rounded-lg">
          <%= link_to post_path(post) do %>
            <p class="text-2xl"><%= post.body %></p>
          <% end %>
        </div>

        <div class="flex justify-start">
          <%= link_to post_path(post), class: "flex flex-col gap-2" do %>
            <svg class="w-[2em] h-[2em] opacity-50 hover:opacity-100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g clip-path="url(#clip0_429_11233)"> <path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 13.4876 3.36093 14.891 4 16.1272L3 21L7.8728 20C9.10904 20.6391 10.5124 21 12 21Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path> </g> <defs> <clipPath id="clip0_429_11233"> <rect width="24" height="24" fill="currentColor"></rect> </clipPath> </defs> </g></svg>
          <% end %>
        </div>

        <div>
          <ul>
            <% post.comments.limit(3).each do |comment| %>
              <li class="border border-gray-200 p-2 rounded-2xl mb-1">
                <div class="flex flex-col">
                  <%= link_to user_path(comment.user.id), class: "flex flex-wrap items-center gap-2" do %>
                    <h3 class="text-xl font-bold"><%= comment.user.username %></h3>
                    <h3 class="text-xl opacity-50"><%= comment.user.email %></h3>
                  <% end %>
                  <div>
                    <p class="text-sm opacity-50"><%= comment.created_at.strftime("%m-%d-%Y %I:%M%p") %></p>
                  </div>
                </div>
                <%= link_to post_path(post), class: "flex flex-col gap-2 w-full p-2 hover:bg-gray-100 rounded-lg" do %>
                  <div>
                    <p class="text-xl" data-posts-target="commentBody"><%= comment.body %></p>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </li>
    <% end %>
  </ul>
</div>
