<div class="flex flex-wrap justify-center p-5 gap-3 w-screen h-screen">
  <div class="flex flex-col gap-3 bg-white rounded-4xl p-5 shadow w-full max-w-[50em] h-fit">
    <span class="overflow-x-hidden">
      <h1 class="text-4xl font-bold"><%= @user.username %></h1>
      <h3 class="text-xl opacity-50"><%= @user.email %></h3>
    </span>
    <div>
      <span>
        <h3 class="text-2xl overflow-x-hidden">Name: <%= "#{@user.first_name} #{@user.last_name}" %></h1>
        <h3 class="text-2xl overflow-x-hidden">Birthday: <%= @user.date_of_birth %></h3>
        <h3 class="text-2xl overflow-x-hidden <%= @user.verified ? "text-green-800" : "text-red-800" %>" >Verified?: <%= @user.verified ? "verified" : "Not verified" %></h3>
      </span>
    </div>
  </div>
  <ul class="flex flex-col gap-3 bg-white rounded-4xl p-5 shadow w-full max-w-[50em] h-full max-h-[80em] overflow-y-auto">
    <% @user.posts.each do |post|%>
      <li class="card overflow-hidden">
        <div class="flex flex-wrap justify-between w-full items-center gap-2">
          <%= link_to user_path(post.user.id), class: "flex flex-wrap gap-2 overflow-x-hidden" do %>
            <h3 class="text-xl font-bold"><%= post.user.username %></h3>
            <h4 class="text-xl opacity-50"><%= post.user.email %></h4>
          <% end %>
          <p class="opacity-50 overflow-x-hidden"><%= post.created_at.strftime("%m-%d-%Y %I:%M%p ") %></p>
        </div>

        <div class="flex flex-col gap-5 overflow-x-hidden w-full hover:bg-gray-100 p-2 rounded-lg">
          <%= link_to post_path(post) do %>
            <p class="text-2xl"><%= post.body %></p>
          <% end %>
        </div>

        <div class="flex justify-start">
          <%= link_to post_path(post), class: "flex flex-col gap-2" do %>
            <svg class="w-[2em] h-[2em] opacity-50 hover:opacity-100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g clip-path="url(#clip0_429_11233)"> <path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 13.4876 3.36093 14.891 4 16.1272L3 21L7.8728 20C9.10904 20.6391 10.5124 21 12 21Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path> </g> <defs> <clipPath id="clip0_429_11233"> <rect width="24" height="24" fill="currentColor"></rect> </clipPath> </defs> </g></svg>
          <% end %>
        </div>

        <div>
          <ul>
            <% post.comments.limit(3).each do |comment| %>
              <li class="border border-gray-200 p-2 rounded-2xl mb-1">
                <div class="flex flex-col">
                  <%= link_to user_path(comment.user.id), class: "flex flex-wrap items-center gap-2" do %>
                    <h3 class="text-xl font-bold"><%= comment.user.username %></h3>
                    <h3 class="text-xl opacity-50"><%= comment.user.email %></h3>
                  <% end %>
                  <div>
                    <p class="text-sm opacity-50"><%= comment.created_at.strftime("%m-%d-%Y %I:%M%p") %></p>
                  </div>
                </div>
                <%= link_to post_path(post), class: "flex flex-col gap-2 w-full p-2 hover:bg-gray-100 rounded-lg" do %>
                  <div>
                    <p class="text-xl" data-posts-target="commentBody"><%= comment.body %></p>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </li>
    <% end %>
  </ul>
</div>
